{
  "name": "@byonesix/observe",
  "version": "0.1.0",
  "description": "Sends errors and logs from an Electron app to Observe.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./electron/main": {
      "types": "./dist/electron/main.d.ts",
      "default": "./dist/electron/main.cjs"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload.d.ts",
      "default": "./dist/electron/preload.cjs"
    },
    "./electron/renderer": {
      "types": "./dist/electron/renderer.d.ts",
      "import": "./dist/electron/renderer.mjs",
      "default": "./dist/electron/renderer.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "electron/main": [
        "dist/electron/main.d.ts"
      ],
      "electron/preload": [
        "dist/electron/preload.d.ts"
      ],
      "electron/renderer": [
        "dist/electron/renderer.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "electron": ">=28",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "test": "bun test test/unit test/crash"
  },
  "devDependencies": {
    "@types/bun": "1.3.2",
    "@types/react": "18.3.26",
    "electron": "34.5.8",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3"
  }
}
